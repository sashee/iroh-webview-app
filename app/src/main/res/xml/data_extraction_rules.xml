<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The saved tickets are addresses rather than
  secrets, but the cookie jar behind them is a live session, and a cloud backup
  is a copy of it somewhere we do not control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

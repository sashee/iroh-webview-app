<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Two permissions, both networking. Downloads need none: scoped storage
      covers DownloadManager from API 29, and minSdk is 34. The app reads no
      storage, no contacts and no location, and a reviewer should be able to see
      that from here.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Not networking of our own: iroh reads the active network's nameservers
      through LinkProperties.getDnsServers(), which needs this. Without it the
      JNI call throws and iroh falls back to Google's public DNS, which works
      but sends every lookup off the local network and fails wherever external
      DNS is blocked.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".IrohBrowserApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.IrohBrowser"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

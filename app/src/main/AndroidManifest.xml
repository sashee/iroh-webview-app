<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Two networking permissions, one for passkeys and two for playing in the
      background. Downloads need none:
      scoped storage covers DownloadManager from API 29, and minSdk is 34. The
      app reads no storage, no contacts and no location, and a reviewer should
      be able to see that from here.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Not networking of our own: iroh reads the active network's nameservers
      through LinkProperties.getDnsServers(), which needs this. Without it the
      JNI call throws and iroh falls back to Google's public DNS, which works
      but sends every lookup off the local network and fails wherever external
      DNS is blocked.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Passkeys: a page's sign-in is signed by a Keystore key that only unlocks
      with a fingerprint (or the screen lock), and BiometricPrompt is how the
      app asks for it. A normal permission; it grants no access to biometric
      data, only the right to show the system prompt.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Playing in the background: while a page plays, a foreground service of
      type mediaPlayback holds the player's notification, and keeps Android
      from freezing the app, and the page with it, when the screen goes off.
      No notification permission: a media session's notification needs none.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".IrohBrowserApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.IrohBrowser"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
